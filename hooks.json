{
  "agy-cmd-router": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.mjs",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|call_mcp_tool|.*apply_edits|.*run_checks",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-tool-use.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/pre-invocation.mjs",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop.mjs",
        "timeout": 5
      }
    ]
  }
}
